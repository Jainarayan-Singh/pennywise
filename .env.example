# Copy to .env and fill in. Never commit .env. Every setting is explained in docs/CONFIGURATION.md.

# Application
APP_ENV=development
SECRET_KEY=
DEBUG=false
LOG_LEVEL=INFO

# Branding
APP_NAME=Penny Wise
COPYRIGHT_YEAR=2026
# One of: Segoe Script, Gabriola, URW Chancery L, Monotype Corsiva, Apple Chancery,
# Playfair Display Italic, Cormorant Garamond Italic, Lora Italic. Restart the server after changing it.
APP_BRAND_FONT=Playfair Display Italic

# The address users open (scheme and host only). Email links, cookies and passkeys all use it. https in production.
APP_BASE_URL=http://localhost:5000

# PostgreSQL
DATABASE_URL=
DATABASE_SSL_MODE=prefer
# Optional: keep all tables in their own PostgreSQL schema (created automatically). Recommended on a shared or hosted
# database, and needed when the connection has no default schema. Lowercase letters, digits, underscores.
DATABASE_SCHEMA=

# Email through any HTTP API. Leave EMAIL_SERVICE_URL empty in development to write emails to instance/outbox/.
# Placeholders for the payload: {from_email} {to_email} {to_name} {subject} {html} {text} {app_name}
EMAIL_SERVICE_API_KEY=
EMAIL_SERVICE_URL=
DEFAULT_FROM_EMAIL=
EMAIL_SERVICE_AUTH_HEADER=api-key
EMAIL_SERVICE_AUTH_PREFIX=
EMAIL_SERVICE_PAYLOAD_TEMPLATE={"sender":{"email":"{from_email}"},"to":[{"email":"{to_email}","name":"{to_name}"}],"subject":"{subject}","htmlContent":"{html}","textContent":"{text}"}
# Brevo example: EMAIL_SERVICE_URL=https://api.brevo.com/v3/smtp/email  (header api-key, no prefix)
# Bearer-style providers: EMAIL_SERVICE_AUTH_HEADER=Authorization and EMAIL_SERVICE_AUTH_PREFIX=Bearer

# Gemini (Quick add). Leave AI_API_KEY empty to switch it off.
AI_API_KEY=
AI_TEXT_MODEL=
AI_FALLBACK_MODEL=
AI_TIMEOUT_SECONDS=45
AI_REQUESTS_PER_MINUTE=10
AI_DAILY_REQUEST_BUDGET=0
# Setting a model enables voice entry (needs AI_API_KEY).
TRANSCRIPTION_MODEL=

# Sign-in
AUTH_SESSION_LIFETIME=720
PASSWORD_HASH_METHOD=scrypt
LOGIN_RATE_LIMIT=5 per minute

# Defaults for new accounts
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
